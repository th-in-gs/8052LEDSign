; Fill channel n's 12-byte record at 80h + 12(n-1) from the window block:
;   +0 type (WIN_E0 bits 6-4)   +1 WIN_E0 bits 3-0   +2..+7 WIN_E1..E6
;   +8 WIN_E7 bits 5-4          +9 WIN_E8 bits 7-6   +A WIN_E8 bits 5-4
;   +B WIN_E9
