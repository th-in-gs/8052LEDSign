; Per-channel handshake. For each channel, an indirect write 10h+n-1 = C0h.
; Then for each channel: send 26 04 88 to 30h+n-1, send 66 to n-1 and expect
; 66 04 88 back (the value just written), then send 30 11 2B 11 2B (readings
; invalid) to 30h+n-1.
;   Calls: link_iwrite_channel, link_prepare, delay_3C, delay_50, link_error
channel_handshake:      ; from 06BF 08B1 190E 19A0 1A57 1B66 +13
  0BC2  8F 73      MOV 73h,R7
  0BC4  7F 08      MOV R7,#08h

L0BC6:                  ; from 0BCB
  0BC6  7B C0      MOV R3,#C0h
  0BC8  12 2F 41   LCALL link_iwrite_channel ; wait link ready, indirect write R3 -> 10h+n-1
  0BCB  DF F9      DJNZ R7,L0BC6
  0BCD  79 E3      MOV R1,#E3h
  0BCF  F3         MOVX @R1,A                ; WATCHDOG <- A
  0BD0  7F 08      MOV R7,#08h

L0BD2:                  ; from 0CBB
  0BD2  79 E3      MOV R1,#E3h
  0BD4  F3         MOVX @R1,A                ; WATCHDOG <- A
  0BD5  12 05 84   LCALL link_prepare        ; prepare link for a new message
  0BD8  74 26      MOV A,#26h
  0BDA  75 83 00   MOV DPH,#00h
  0BDD  75 82 08   MOV DPL,#08h
  0BE0  F0         MOVX @DPTR,A              ; LINK_FIFO <- 26h
  0BE1  74 04      MOV A,#04h
  0BE3  75 83 00   MOV DPH,#00h
  0BE6  75 82 08   MOV DPL,#08h
  0BE9  F0         MOVX @DPTR,A              ; LINK_FIFO <- 04h
  0BEA  74 88      MOV A,#88h
  0BEC  75 83 00   MOV DPH,#00h
  0BEF  75 82 08   MOV DPL,#08h
  0BF2  F0         MOVX @DPTR,A              ; LINK_FIFO <- 88h
  0BF3  74 2F      MOV A,#2Fh
  0BF5  2F         ADD A,R7                  ; A = 2Fh+n
  0BF6  75 83 00   MOV DPH,#00h
  0BF9  75 82 0A   MOV DPL,#0Ah
  0BFC  F0         MOVX @DPTR,A              ; LINK_DEST <- 30h+n-1
  0BFD  74 01      MOV A,#01h
