  068E  C2 98      CLR RI
  0690  30 04 1E   JNB 20h.4,L06B1
  0693  30 07 07   JNB 20h.7,L069D
  0696  85 99 00   MOV 00h,SBUF
  0699  C2 07      CLR 20h.7
  069B  80 12      SJMP L06AF

L069D:                  ; from 0693
  069D  05 06      INC 06h
  069F  74 08      MOV A,#08h
  06A1  B5 06 04   CJNE A,06h,L06A8
  06A4  C2 04      CLR 20h.4
  06A6  D2 08      SETB 21h.0

L06A8:                  ; from 06A1
  06A8  A2 9A      MOV C,RB8                 ; echo with the same 9th bit
  06AA  92 9B      MOV TB8,C
  06AC  85 99 99   MOV SBUF,SBUF             ; echo the byte

L06AF:                  ; from 069B
  06AF  80 3E      SJMP L06EF

L06B1:                  ; from 0690
  06B1  E5 99      MOV A,SBUF
  06B3  A2 D0      MOV C,P                   ; parity of the data byte...
  06B5  30 9A 01   JNB RB8,L06B9             ; ...compared with the 9th bit
  06B8  B3         CPL C

L06B9:                  ; from 06B5
  06B9  20 0A 01   JB PARITY_ODD,L06BD
  06BC  B3         CPL C

L06BD:                  ; from 06B9
