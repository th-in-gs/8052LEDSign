  02E4  91 CB      ACALL rotate_phase
  02E6  C4         SWAP A
  02E7  F5 43      MOV PHASE_A,A
  02E9  91 DB      ACALL count_step
  02EB  92 79      MOV 2Fh.1,C

L02ED:                  ; from 02DC
  02ED  22         RET

